generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(10)
  description String    @db.VarChar(100)
  price       Int
  tags        Tag[]
  comments    Comment[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("products")
}

model Tag {
  tagId        Int      @default(autoincrement())
  name      String   @db.VarChar(5)
  productId Int      @map("product_id")
  products  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, name])
  @@map("tags")
}

model Article {
  id        Int       @id @default(autoincrement())
  title     String    @db.VarChar(50)
  content   String
  comments  Comment[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("articles")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  productId Int?     @map("product_id")
  articleId Int?     @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  products  Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  articles  Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("comments")
}
